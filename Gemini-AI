local function cleanupLegacy()
    if CONFIG.destroyLegacyGui then
        local containers = { playerGui }
        pcall(function()
            table.insert(containers, game:GetService("CoreGui"))
        end)
        for _, container in ipairs(containers) do
            if container then
                pcall(function()
                    for _, child in ipairs(container:GetChildren()) do
                        if child.Name == "GeminiAIGui" or child.Name == "GeminiAI_Disconnected" then
                            child:Destroy()
                        end
                    end
                end)
            end
        end
    end

    if CONFIG.purgeLegacyData then
        pcall(function()
            if delfile and isfile and isfile("GeminiAI_Data.json") then
                delfile("GeminiAI_Data.json")
                warn("[Gemini AI] disconnected - legacy data file removed (stored API keys purged).")
            end
        end)
    end
end

