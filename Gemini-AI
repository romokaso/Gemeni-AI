-- A ring of dots with a gap at the top, so it reads as a power symbol.
local function buildDotRing(parent, radius, dotCount, dotSize, gapDegrees, dimColor)
    local dots = {}
    local gap = math.rad(gapDegrees or 0)
    local arc = math.pi * 2 - gap
    for i = 1, dotCount do
        local frac = (i - 1) / dotCount
        local angle = -math.pi * 0.5 + gap * 0.5 + frac * arc
        local x = math.cos(angle) * radius
        local y = math.sin(angle) * radius
        local dot = new("Frame", {
            Name = "Dot" .. i,
            Size = UDim2.new(0, dotSize, 0, dotSize),
            Position = UDim2.new(0.5, x - dotSize * 0.5, 0.5, y - dotSize * 0.5),
            BackgroundColor3 = dimColor or C.dim,
            BackgroundTransparency = 0.6,
            BorderSizePixel = 0,
        }, parent)
        corner(dotSize * 0.5, dot)
        dots[i] = dot
    end
    return dots
end

local function buildParticles(parent, count)
    local vw, vh = viewportSize()
    for _ = 1, count do
        local size = math.random(1, 4)
        local p = {
            speed = 0.25 + math.random() * 0.9,
            swaySpeed = 0.3 + math.random() * 0.9,
            swayAmp = 4 + math.random() * 22,
            twinkleSpeed = 0.6 + math.random() * 1.8,
            phase = math.random() * math.pi * 2,
            x = math.random(),
            y = math.random() * vh,
            baseTr = 0.45 + math.random() * 0.45,
        }
        p.frame = new("Frame", {
            Name = "Mote",
            Size = UDim2.new(0, size, 0, size),
            Position = UDim2.new(p.x, 0, 0, p.y),
            BackgroundColor3 = math.random() < 0.25 and C.cyan or C.accent,
            BackgroundTransparency = p.baseTr,
            BorderSizePixel = 0,
        }, parent)
        corner(size * 0.5, p.frame)
        ANIM.particles[#ANIM.particles + 1] = p
    end
end

-- Soft moving light bar (used for the backdrop sweep and the card shine).
local function buildSweep(parent, size, color, rotation)
    local bar = new("Frame", {
        Name = "Sweep",
        Size = size,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Rotation = rotation or 0,
    }, parent)
    gradient(
        { color, color, color },
        NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(0.5, 0.55),
            NumberSequenceKeypoint.new(1, 1),
        }),
        0,
        bar
    )
    return bar
end

