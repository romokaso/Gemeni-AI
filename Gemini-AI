local ANIM = {
    rings     = {},      -- dot rings with a comet chase
    particles = {},      -- drifting dust
    pulses    = {},      -- breathing glows / strokes
    running   = true,
}

local function registerRing(dots, opts)
    ANIM.rings[#ANIM.rings + 1] = {
        dots   = dots,
        speed  = opts.speed or 0.30,
        sharp  = opts.sharp or 3.0,
        dim    = opts.dim or C.dim,
        bright = opts.bright or C.accent,
        minTr  = opts.minTr or 0.55,
        maxTr  = opts.maxTr or 0.00,
        tint   = opts.tint,          -- optional dynamic color override fn
    }
end

local function registerPulse(obj, property, from, to, speed)
    ANIM.pulses[#ANIM.pulses + 1] = {
        obj = obj, prop = property, from = from, to = to, speed = speed or 0.8, phase = math.random() * 6.28,
    }
end

-- stop a dot ring chase (used once the cinematic is folded away)
local function stopRing(dots)
    for _, ring in ipairs(ANIM.rings) do
        if ring.dots == dots then
            ring.dots = {}
        end
    end
end

-- stop an ambient pulse so a scripted fade is not overwritten every frame
local function stopPulse(obj)
    for _, pulse in ipairs(ANIM.pulses) do
        if pulse.obj == obj then
            pulse.obj = nil
        end
    end
end

local function startAnimationLoop()
    local connection
    connection = RunService.RenderStepped:Connect(function(dt)
        if not ANIM.running then
            if connection then connection:Disconnect() end
            return
        end

        local t = clock()
        dt = math.min(dt or 0.016, 0.1)

        -- comet chase on every dot ring
        for _, ring in ipairs(ANIM.rings) do
            local n = #ring.dots
            local tint = ring.tint and ring.tint() or ring.bright
            for i, dot in ipairs(ring.dots) do
                local phase = ((i - 1) / n - t * ring.speed) % 1
                local wave = (math.sin(phase * math.pi * 2 - math.pi * 0.5) + 1) * 0.5
                wave = wave ^ ring.sharp
                if dot and dot.Parent then
                    dot.BackgroundColor3 = ring.dim:Lerp(tint, wave)
                    dot.BackgroundTransparency = ring.maxTr + (ring.minTr - ring.maxTr) * (1 - wave)
                end
            end
        end

        -- drifting dust
        local vw, vh = viewportSize()
        for _, p in ipairs(ANIM.particles) do
            if p.frame and p.frame.Parent then
                p.y = p.y - p.speed * dt * 60
                if p.y < -20 then
                    p.y = vh + math.random(0, 60)
                    p.x = math.random()
                end
                local sway = math.sin(t * p.swaySpeed + p.phase) * p.swayAmp
                local twinkle = math.sin(t * p.twinkleSpeed + p.phase * 2) * 0.18
                p.frame.Position = UDim2.new(p.x, sway, 0, p.y)
                p.frame.BackgroundTransparency = clamp01(p.baseTr + twinkle)
            end
        end

        -- breathing glows
        for _, pulse in ipairs(ANIM.pulses) do
            if pulse.obj and pulse.obj.Parent then
                local wave = (math.sin(t * pulse.speed + pulse.phase) + 1) * 0.5
                local value = pulse.from + (pulse.to - pulse.from) * wave
                if pulse.prop == "BackgroundTransparency" or pulse.prop == "Transparency" then
                    value = clamp01(value)
                end
                pulse.obj[pulse.prop] = value
            end
        end
    end)

    return connection
end

