local function shakeCard()
    local baseX, baseY = -280, -310
    local offsets = { { 6, -3 }, { -7, 2 }, { 5, 3 }, { -4, -2 }, { 2, 1 }, { 0, 0 } }
    for _, o in ipairs(offsets) do
        card.Position = UDim2.new(0.5, baseX + o[1], 0.5, baseY + o[2])
        twait(T(0.035))
    end
    card.Position = UDim2.new(0.5, baseX, 0.5, baseY)
end

local function powerOffFlash()
    -- ring + bar switch from indigo to red, halo flares, card shakes
    tween(halo, T(0.18), { BackgroundColor3 = C.danger, BackgroundTransparency = 0.55 }, Enum.EasingStyle.Quart)
    tween(powerBar, T(0.18), { BackgroundColor3 = C.danger }, Enum.EasingStyle.Quart)
    tween(powerBarGlow, T(0.18), { BackgroundColor3 = C.danger, BackgroundTransparency = 0.78 }, Enum.EasingStyle.Quart)
    tween(cardStroke, T(0.18), { Color = C.danger, Transparency = 0.15 }, Enum.EasingStyle.Quart)
    tween(topLine, T(0.18), { BackgroundColor3 = C.danger }, Enum.EasingStyle.Quart)

    for _, ring in ipairs(ANIM.rings) do
        if ring.dots == ringDots then
            ring.bright = C.danger
            ring.speed = 0.05
        end
    end

    iconScale.Scale = 1.09
    tween(iconScale, T(0.55), { Scale = 0.96 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

    shakeCard()

    tween(halo, T(1.1), { BackgroundTransparency = 0.88 }, Enum.EasingStyle.Quart)
    tween(cardStroke, T(1.1), { Transparency = 0.55 }, Enum.EasingStyle.Quart)
end

local function runProgress(seconds, onDone)
    local steps = 60
    local step = seconds / steps
    for i = 1, steps do
        if not ANIM.running then return end
        local pct = i / steps
        local eased = 1 - (1 - pct) ^ 1.6
        progressFill.Size = UDim2.new(eased, 0, 1, 0)
        progressLabel.Text = string.format("%s   %d%%", TXT.working, math.floor(eased * 100))
        fillGradient.Offset = Vector2.new(math.sin(clock() * 1.5) * 0.25, 0)
        twait(step)
    end
    progressFill.Size = UDim2.new(1, 0, 1, 0)
    progressLabel.Text = TXT.done
    tween(progressLabel, T(0.4), { TextColor3 = C.danger }, Enum.EasingStyle.Quart)
    if onDone then onDone() end
end

local function typewrite(label, text, speed)
    for i = 1, #text do
        if not ANIM.running then return end
        label.Text = text:sub(1, i) .. "|"
        twait(speed)
    end
    label.Text = text
    -- blink the caret away
    for _ = 1, 3 do
        label.Text = text .. "|"
        twait(T(0.18))
        label.Text = text .. " "
        twait(T(0.18))
    end
    label.Text = text
end

local function collapseToBadge()
    if not CONFIG.keepBadge then
        tween(backdrop, T(0.6), { BackgroundTransparency = 1 })
        tween(card, T(0.6), { BackgroundTransparency = 1 })
        tdelay(T(0.7), function()
            if ANIM.running then
                gui:Destroy()
            end
        end)
        return
    end

    -- everything cinematic fades out
    stopPulse(halo)
    tween(backdrop, T(0.55), { BackgroundTransparency = 1 }, Enum.EasingStyle.Quart)
    tween(vignetteV, T(0.55), { BackgroundTransparency = 1 }, Enum.EasingStyle.Quart)
    tween(particleLayer, T(0.5), { GroupTransparency = 1 }, Enum.EasingStyle.Quart)
    tween(cardScaleObj, T(0.55), { Scale = cardScale * 0.9 }, Enum.EasingStyle.Quart)
    for _, obj in ipairs({ cardStroke, topLine }) do
        tween(obj, T(0.45), { Transparency = 1 }, Enum.EasingStyle.Quart)
    end
    tween(card, T(0.55), { BackgroundTransparency = 1 }, Enum.EasingStyle.Quart)
    for _, child in ipairs(card:GetDescendants()) do
        if child:IsA("TextLabel") then
            tween(child, T(0.4), { TextTransparency = 1 }, Enum.EasingStyle.Quart)
        elseif child:IsA("Frame") and child.Name ~= "Card" then
            tween(child, T(0.4), { BackgroundTransparency = 1 }, Enum.EasingStyle.Quart)
        end
    end
    tween(halo, T(0.4), { BackgroundTransparency = 1 }, Enum.EasingStyle.Quart)

    twait(T(0.5))
    card.Visible = false
    particleLayer.Visible = false
    vignetteV.Visible = false
    backSweep.Visible = false

    -- stop simulating things nobody can see anymore
    stopRing(ringDots)
    ANIM.particles = {}

    -- badge pops in
    badge.Visible = true
    local badgeScale = new("UIScale", { Scale = 0.7 }, badge)
    tween(badgeScale, T(0.55), { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    tween(badge, T(0.45), { BackgroundTransparency = 0.08 }, Enum.EasingStyle.Quart)
    tween(badgeStroke, T(0.45), { Transparency = 0.45 }, Enum.EasingStyle.Quart)
    tween(badgeTitle, T(0.5), { TextTransparency = 0 }, Enum.EasingStyle.Quart)
    tween(badgeSub, T(0.6), { TextTransparency = 0.15 }, Enum.EasingStyle.Quart)
    tween(badgeHalo, T(0.6), { BackgroundTransparency = 0.82 }, Enum.EasingStyle.Quart)
    tween(badgeBar, T(0.5), { BackgroundTransparency = 0.1 }, Enum.EasingStyle.Quart)

    registerPulse(badgeHalo, "BackgroundTransparency", 0.72, 0.92, 1.1)
    registerPulse(badgeStroke, "Transparency", 0.35, 0.75, 0.9)

    tspawn(function()
        while ANIM.running and badge.Parent do
            badgeShine.Position = UDim2.new(0, -80, 0, -30)
            tween(badgeShine, T(1.4), { Position = UDim2.new(0, 320, 0, -30) }, Enum.EasingStyle.Linear)
            twait(T(4.5 + math.random() * 3))
        end
    end)
end

local function glitchBurst()
    local target = titleFrame
    if not target or not target.Parent then return end
    local original = target.Position
    for _ = 1, 3 do
        if not ANIM.running then return end
        target.Position = UDim2.new(0, math.random(-6, 6), 0, original.Y.Offset + math.random(-2, 2))
        for i, entry in ipairs(letters) do
            entry.label.TextColor3 = (i % 2 == 0) and C.cyan or C.danger
            entry.label.TextTransparency = math.random() * 0.35
        end
        twait(T(0.045))
        target.Position = original
        for _, entry in ipairs(letters) do
            entry.label.TextColor3 = C.text
            entry.label.TextTransparency = 0
        end
        twait(T(0.045))
    end
end

local function playIntro()
    print("[Gemini AI] DISCONNECTED - the assistant has been disabled. Playing shutdown overlay.")

    startAnimationLoop()

    -- backdrop + card entrance
    tween(backdrop, T(0.7), { BackgroundTransparency = 0.12 }, Enum.EasingStyle.Quart)
    tween(vignetteV, T(0.9), { BackgroundTransparency = 0 }, Enum.EasingStyle.Quart)
    cardScaleObj.Scale = cardScale * 0.86
    tween(cardScaleObj, T(0.85), { Scale = cardScale }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    tween(card, T(0.5), { BackgroundTransparency = 0.06 }, Enum.EasingStyle.Quart)
    tween(cardStroke, T(0.6), { Transparency = 0.35 }, Enum.EasingStyle.Quart)

    registerPulse(halo, "BackgroundTransparency", 0.80, 0.93, 0.9)

    -- background sweep, looping
    tspawn(function()
        while ANIM.running and backSweep.Parent and backSweep.Visible do
            backSweep.Position = UDim2.new(-0.2, 0, 0, -240)
            tween(backSweep, T(5.5), { Position = UDim2.new(-0.2, 0, 1, 240) }, Enum.EasingStyle.Linear)
            twait(T(5.5) + T(math.random() * 2))
        end
    end)

    twait(T(0.35))
    tween(headerLabel, T(0.6), { TextTransparency = 0.25 }, Enum.EasingStyle.Quart)

    twait(T(0.25))
    tween(halo, T(0.8), { BackgroundTransparency = 0.85 }, Enum.EasingStyle.Quart)
    tween(powerBarGlow, T(0.8), { BackgroundTransparency = 0.86 }, Enum.EasingStyle.Quart)

    -- title scramble reveal
    twait(T(0.15))
    for i = 1, #letters do
        revealLetter(i)
        twait(T(0.055))
    end

    twait(T(0.45))
    tspawn(function() typewrite(subtitle, TXT.subtitle, T(0.028)) end)

    twait(T(0.55))
    divider.Position = UDim2.new(0.5, 0, 0, 360)
    tween(divider, T(0.7), { Size = UDim2.new(0, 300, 0, 1), Position = UDim2.new(0.5, -150, 0, 360) }, Enum.EasingStyle.Quart)

    -- status rows: scan, then lock to OFFLINE
    twait(T(0.35))
    for i, entry in ipairs(rows) do
        if not ANIM.running then return end
        entry.row.Position = UDim2.new(0, -14, 0, 0)
        tween(entry.row, T(0.25), { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Quart)
        tween(entry.dot, T(0.3), { BackgroundTransparency = 0 }, Enum.EasingStyle.Quart)
        tween(entry.name, T(0.35), { TextTransparency = 0.05 }, Enum.EasingStyle.Quart)
        tween(entry.detail, T(0.45), { TextTransparency = 0.45 }, Enum.EasingStyle.Quart)
        entry.dot.BackgroundColor3 = C.amber

        tspawn(function()
            for _ = 1, 3 do
                if not ANIM.running then return end
                tween(entry.dot, T(0.09), { BackgroundColor3 = C.amber }, Enum.EasingStyle.Linear)
                twait(T(0.1))
                tween(entry.dot, T(0.09), { BackgroundColor3 = C.dim }, Enum.EasingStyle.Linear)
                twait(T(0.1))
            end
            tween(entry.dot, T(0.2), { BackgroundColor3 = C.danger }, Enum.EasingStyle.Quart)
            tween(entry.state, T(0.3), { TextTransparency = 0.1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        end)

        twait(T(0.26))
    end

    -- the moment the power is cut
    twait(T(0.25))
    powerOffFlash()
    if CONFIG.glitchy then
        glitchBurst()
    end

    twait(T(0.35))
    tween(progressLabel, T(0.4), { TextTransparency = 0.15 }, Enum.EasingStyle.Quart)
    tween(progressTrack, T(0.4), { BackgroundTransparency = 0.3 }, Enum.EasingStyle.Quart)

    runProgress(T(2.4), function()
        tween(footerLabel, T(0.7), { TextTransparency = 0.45 }, Enum.EasingStyle.Quart)
    end)

    -- hold the finished frame for a beat, then fold into the badge
    twait(T(2.1))
    collapseToBadge()

    -- idle glitch loop on the badge title
    if CONFIG.glitchy and CONFIG.keepBadge then
        tspawn(function()
            while ANIM.running and badge.Parent do
                twait(T(3.5 + math.random() * 5))
                if not ANIM.running then break end
                local flash = math.random() < 0.5
                badgeTitle.TextColor3 = flash and C.danger or C.text
                badgeTitle.Position = UDim2.new(0, 58 + math.random(-2, 2), 0, 9)
                twait(T(0.07))
                badgeTitle.TextColor3 = C.text
                badgeTitle.Position = UDim2.new(0, 58, 0, 9)
            end
        end)
    end
end

-- keep the render loop tidy if the GUI is ever destroyed
pcall(function()
    gui.Destroying:Connect(function()
        ANIM.running = false
        ANIM.particles = {}
        ANIM.rings = {}
        ANIM.pulses = {}
    end)
end)

local ok, err = pcall(playIntro)
if not ok then
    warn("[Gemini AI] disconnected overlay failed to play: " .. tostring(err))
end
