local function revealLetter(index)
    local entry = letters[index]
    if not entry then return end
    local label = entry.label

    tspawn(function()
        -- scramble phase
        local steps = 7
        for s = 1, steps do
            if not ANIM.running then return end
            label.Text = SCRAMBLE:sub(math.random(1, #SCRAMBLE), math.random(1, #SCRAMBLE))
            label.TextColor3 = C.cyan:Lerp(C.text, s / steps)
            label.TextTransparency = clamp01(1 - (s / steps) * 0.85)
            label.Position = UDim2.new(0, 0, 0, 16 - (s / steps) * 16)
            label.Rotation = (math.random() - 0.5) * 8
            twait(T(0.035))
        end
        label.Text = entry.char
        label.Rotation = 0
        label.Position = UDim2.new(0, 0, 0, 0)
        label.TextColor3 = C.text
        label.TextTransparency = 0.15
        tween(label, T(0.22), { TextTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        -- tiny pop: start big, settle to the real size
        label.TextSize = 52
        tween(label, T(0.30), { TextSize = 46 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    end)
end

