---------------------------------------------------------------------------
--  3. SMALL BUILDING HELPERS
---------------------------------------------------------------------------

local function new(className, props, parent)
    local inst = Instance.new(className)
    if props then
        for key, value in pairs(props) do
            inst[key] = value
        end
    end
    inst.Parent = parent
    return inst
end

local function corner(radius, parent)
    return new("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
end

local function stroke(color, thickness, transparency, parent)
    return new("UIStroke", {
        Color = color,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, parent)
end

local function gradient(colors, transparency, rotation, parent)
    local colorKeys = {}
    for i, c in ipairs(colors) do
        colorKeys[i] = ColorSequenceKeypoint.new((i - 1) / math.max(1, #colors - 1), c)
    end
    local g = new("UIGradient", {
        Color = ColorSequence.new(colorKeys),
        Rotation = rotation or 0,
    }, parent)
    if transparency then
        g.Transparency = transparency
    end
    return g
end

local function tween(obj, seconds, props, style, direction, delay)
    local info = TweenInfo.new(
        math.max(0.001, seconds),
        style or Enum.EasingStyle.Quart,
        direction or Enum.EasingDirection.Out,
        0, false, delay or 0
    )
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

local function clamp01(v)
    if v ~= v then return 1 end            -- NaN guard
    return math.max(0, math.min(1, v))
end

